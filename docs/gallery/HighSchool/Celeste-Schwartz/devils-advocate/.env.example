# Copy this file to `.env` and fill in your Anthropic API key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (the defaults work out of the box):
# Which model to debate with. Default: claude-opus-5
#MODEL=claude-sonnet-5
# Port for the local server. Default: 3000
#PORT=3000
